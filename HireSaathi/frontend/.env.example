# ==========================================
# HireSaathi Frontend Environment Variables
# ==========================================

# Backend API URL (Your Render backend service URL without trailing slash)
# For local development: http://localhost:8000
# For production: https://your-backend-app.onrender.com
VITE_BACKEND_URL=http://localhost:8000

# Firebase Web App API Key
# Firebase Console -> Project Settings -> General -> Your apps -> Web app config -> apiKey
VITE_FIREBASE_APIKEY=AIzaSy_your_firebase_web_api_key

# (Optional Firebase web configs - defaults to existing project if omitted)
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# VITE_FIREBASE_APP_ID=your_app_id

# Razorpay Key ID (Public key for checkout)
# Razorpay Dashboard -> Settings -> API Keys -> Key Id (starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

