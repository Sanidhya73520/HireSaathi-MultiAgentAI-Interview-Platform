# ==========================================
# HireSaathi Backend Environment Variables
# ==========================================

# Server Port (Render sets this automatically in production)
PORT=8000
NODE_ENV=production

# Frontend URL (For CORS and cookie verification - no trailing slash)
# Replace with your Vercel deployment URL in production (e.g., https://your-project.vercel.app)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Database URL
# Create a free cluster at https://mongodb.com/cloud/atlas
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hiresaathi?retryWrites=true&w=majority

# Redis URL (For session storage and caching)
# Free hosted Redis at https://upstash.com (use the rediss:// URL provided)
REDIS_URL=redis://127.0.0.1:6379

# Groq API Key (For AI Interviewer, Resume ATS scoring, and Roadmap generator)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Firebase Admin SDK Credentials
# Download Service Account JSON from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Option 1: Paste the entire single-line JSON content of serviceAccountKey.json here
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Option 2: Or provide individual fields if you prefer:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# YouTube Data API v3 (For generating recommended YouTube videos in roadmaps)
# Enable "YouTube Data API v3" in Google Cloud Console and create an API Key
YOUTUBE_API_KEY=AIzaSy_your_youtube_api_key_here

# Razorpay Payment Gateway (For interview coin purchases)
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# Microservices Mode (OPTIONAL)
# Leave these commented out if deploying backend as a unified service on Render.
# Only uncomment if deploying separate microservice instances.
# ==========================================
# AUTH_SERVICE_URL=http://localhost:6001
# RESUME_SERVICE_URL=http://localhost:6002
# INTERVIEW_SERVICE_URL=http://localhost:6003
# ROADMAP_SERVICE_URL=http://localhost:6004
# BILLING_SERVICE_URL=http://localhost:6005

